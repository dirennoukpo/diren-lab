---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<figure class="my-6">
  <div class="aspect-video w-full overflow-hidden rounded border border-border dark:border-border-dark">
    <iframe
      class="w-full h-full"
      src={`https://www.youtube-nocookie.com/embed/${id}`}
      title={title}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>
  <figcaption class="mt-2 text-sm text-ink-muted dark:text-ink-muted-dark">
    {title} — <a class="underline" href={`https://youtu.be/${id}`} rel="noopener">youtu.be/{id}</a>
  </figcaption>
</figure>

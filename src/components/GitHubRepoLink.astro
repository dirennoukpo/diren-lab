---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  url: string;
  description: string;
  reproducible: boolean;
}
const { lang, url, description, reproducible } = Astro.props;
const s = t(lang);
---

<li class="border border-border dark:border-border-dark rounded p-4">
  <a href={url} rel="noopener" class="font-mono text-sm text-accent dark:text-accent-dark underline">
    {s.view_repo} ↗
  </a>
  <p class="mt-1 text-sm text-ink-muted dark:text-ink-muted-dark">{description}</p>
  {!reproducible && (
    <p class="mt-1 text-xs text-warning">
      {lang === 'fr' ? 'Reproductibilité non garantie' : 'Reproducibility not guaranteed'}
    </p>
  )}
</li>

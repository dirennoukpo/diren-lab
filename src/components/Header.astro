---
import { t, languages, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);

const links = [
  { href: `/${lang}/`, label: s.nav_home },
  { href: `/${lang}/projects/`, label: s.nav_projects },
  { href: `/${lang}/notions/`, label: s.nav_notions },
  { href: `/${lang}/experiments/`, label: s.nav_experiments },
  { href: `/${lang}/journal/`, label: s.nav_journal },
  { href: `/${lang}/media/`, label: s.nav_media },
  { href: `/${lang}/about/`, label: s.nav_about },
];

const currentPath = Astro.url.pathname;
const otherLang = lang === 'fr' ? 'en' : 'fr';
const otherLangPath = currentPath.replace(/^\/(fr|en)\//, `/${otherLang}/`);
---

<header class="border-b border-border dark:border-border-dark">
  <div class="max-w-5xl mx-auto px-4 py-4 flex flex-wrap items-center justify-between gap-4">
    <a href={`/${lang}/`} class="font-mono text-lg font-semibold tracking-tight">
      diren<span class="text-accent dark:text-accent-dark">.lab</span>
    </a>
    <nav aria-label="Primary">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-ink-muted dark:text-ink-muted-dark hover:text-ink dark:hover:text-ink-dark aria-[current=page]:text-ink aria-[current=page]:dark:text-ink-dark aria-[current=page]:font-medium"
              aria-current={currentPath === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a href={otherLangPath} class="text-xs font-mono border border-border dark:border-border-dark rounded px-2 py-1 text-ink-muted dark:text-ink-muted-dark hover:text-ink dark:hover:text-ink-dark">
      {languages[otherLang]}
    </a>
  </div>
</header>

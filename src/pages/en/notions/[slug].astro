---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RelatedEntities from '../../../components/RelatedEntities.astro';
import Tag from '../../../components/Tag.astro';
import { t } from '../../../i18n/ui';
import { getRelated } from '../../../lib/graph';

const lang = 'en' as const;
const s = t(lang);

export async function getStaticPaths() {
  const notions = await getCollection('notions', (e) => e.data.lang === 'en' && !e.data.draft);
  return notions.map((notion) => ({ params: { slug: notion.id }, props: { notion } }));
}

const { notion } = Astro.props;
const { Content } = await render(notion);
const related = getRelated('notions', notion.id);
---

<BaseLayout lang={lang} title={notion.data.title} description={notion.data.description}>
  <article>
    <Tag variant="accent">{notion.data.domain}</Tag>
    <h1 class="text-3xl font-semibold tracking-tight mt-3">{notion.data.title}</h1>
    <p class="mt-2 text-lg text-ink-muted dark:text-ink-muted-dark">{notion.data.description}</p>
    <div class="prose dark:prose-invert max-w-none mt-6">
      <Content />
    </div>
    <RelatedEntities lang={lang} label={s.related_projects} items={related.filter((r) => r.type === 'projects')} />
    <RelatedEntities lang={lang} label={s.related_experiments} items={related.filter((r) => r.type === 'experiments')} />
  </article>
</BaseLayout>

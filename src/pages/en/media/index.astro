---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import YouTubeEmbed from '../../../components/YouTubeEmbed.astro';
import EnNotice from '../../../components/EnNotice.astro';
import { t } from '../../../i18n/ui';

const lang = 'en' as const;
const s = t(lang);

const projects = await getCollection('projects', (e) => e.data.lang === lang && !e.data.draft && e.data.videos.length > 0);
const experiments = await getCollection('experiments', (e) => e.data.lang === lang && !e.data.draft && e.data.videos.length > 0);

const groups = [
  ...projects.map((p) => ({ title: p.data.title, href: `/en/projects/${p.id}/`, videos: p.data.videos })),
  ...experiments.map((e) => ({ title: e.data.title, href: `/en/experiments/${e.id}/`, videos: e.data.videos })),
];
---

<BaseLayout lang={lang} title={s.nav_media} description="YouTube videos grouped by project and experiment.">
  <EnNotice lang={lang} />
  <h1 class="text-2xl font-semibold">{s.nav_media}</h1>
  <div class="mt-8 space-y-10">
    {groups.length > 0 ? (
      groups.map((group) => (
        <section>
          <h2 class="text-lg font-medium"><a href={group.href} class="hover:text-accent dark:hover:text-accent-dark">{group.title}</a></h2>
          <div class="mt-3 grid gap-4 sm:grid-cols-2">
            {group.videos.map((video) => <YouTubeEmbed id={video.id} title={video.title} />)}
          </div>
        </section>
      ))
    ) : (
      <p class="text-ink-muted dark:text-ink-muted-dark text-sm">{s.empty_state}</p>
    )}
  </div>
</BaseLayout>

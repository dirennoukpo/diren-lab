---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RelatedEntities from '../../../components/RelatedEntities.astro';
import YouTubeEmbed from '../../../components/YouTubeEmbed.astro';
import GitHubRepoLink from '../../../components/GitHubRepoLink.astro';
import Tag from '../../../components/Tag.astro';
import { t } from '../../../i18n/ui';
import { getRelated } from '../../../lib/graph';

const lang = 'fr' as const;
const s = t(lang);

export async function getStaticPaths() {
  const projects = await getCollection('projects', (e) => e.data.lang === 'fr' && !e.data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const related = getRelated('projects', project.id);
---

<BaseLayout lang={lang} title={project.data.title} description={project.data.description}>
  <article>
    <div class="flex items-center gap-2 mb-3">
      <Tag variant="accent">{project.data.domain}</Tag>
      <Tag>{project.data.status}</Tag>
    </div>
    <h1 class="text-3xl font-semibold tracking-tight">{project.data.title}</h1>
    <p class="mt-2 text-lg text-ink-muted dark:text-ink-muted-dark">{project.data.description}</p>

    {project.data.videos.map((video) => <YouTubeEmbed id={video.id} title={video.title} />)}

    <div class="prose dark:prose-invert max-w-none mt-6">
      <Content />
    </div>

    {project.data.github.length > 0 && (
      <section class="mt-8">
        <h2 class="text-sm font-mono uppercase tracking-wide text-ink-muted dark:text-ink-muted-dark mb-2">
          Dépôts GitHub
        </h2>
        <ul class="grid gap-3 sm:grid-cols-2">
          {project.data.github.map((repo) => (
            <GitHubRepoLink lang={lang} url={repo.url} description={repo.description} reproducible={repo.reproducible} />
          ))}
        </ul>
      </section>
    )}

    <RelatedEntities lang={lang} label={s.related_notions} items={related.filter((r) => r.type === 'notions')} />
    <RelatedEntities lang={lang} label={s.related_experiments} items={related.filter((r) => r.type === 'experiments')} />
    <RelatedEntities lang={lang} label={s.related_journal} items={related.filter((r) => r.type === 'journal')} />
  </article>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import Tag from '../../../components/Tag.astro';
import { t } from '../../../i18n/ui';

const lang = 'fr' as const;
const s = t(lang);

const projects = (await getCollection('projects', (e) => e.data.lang === lang && !e.data.draft))
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());

const domains = [...new Set(projects.map((p) => p.data.domain))].sort();
---

<BaseLayout lang={lang} title={s.nav_projects} description="Projets robotique et IA, du prototype au système déployé.">
  <h1 class="text-2xl font-semibold">{s.nav_projects}</h1>

  {/* Client-side filter: fully static build, no server-side query handling. Works without JS by showing every project. */}
  {domains.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2" data-filter-group role="group" aria-label="Filtrer par domaine">
      <button type="button" class="filter-btn" data-domain="all" aria-pressed="true">
        <Tag variant="accent">Tous</Tag>
      </button>
      {domains.map((d) => (
        <button type="button" class="filter-btn" data-domain={d} aria-pressed="false">
          <Tag>{d}</Tag>
        </button>
      ))}
    </div>
  )}

  <div class="mt-6 grid gap-4 sm:grid-cols-2" data-project-list>
    {projects.length > 0 ? (
      projects.map((project) => (
        <div data-domain={project.data.domain}>
          <ProjectCard lang={lang} project={project} />
        </div>
      ))
    ) : (
      <p class="text-ink-muted dark:text-ink-muted-dark text-sm">{s.empty_state}</p>
    )}
  </div>

  <script>
    import '../../../scripts/domain-filter.ts';
  </script>
</BaseLayout>
